# Diagnozer ML Service Configuration

# Set to True to save images locally instead of AWS S3
MOCK_S3_UPLOAD=true
LOCAL_UPLOAD_DIR=uploads

# AWS S3 Configurations (Only needed if MOCK_S3_UPLOAD=false)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=us-east-1

# External URL of this ML service. 
# For mobile app testing, replace 'localhost' with your laptop's local network IP (e.g. http://192.168.1.100:8000)
# so the mobile device can fetch heatmaps and uploaded images successfully.
ML_SERVICE_EXTERNAL_URL=http://localhost:8000
