# Diagnozer Main Backend Configuration

# MongoDB config (in-memory mock is used locally by default, but you can set Atlas URL here)
MONGODB_URL=mongodb://localhost:27017
DB_NAME=diagnozer_db

# Secret key for signing JWT tokens (use a strong random value in production)
SECRET_KEY=super_secret_dev_key_change_in_production

# URL where the secondary ML Service runs
ML_SERVICE_URL=http://localhost:8000

# Google Gemini API key for Chatbot (Required for chat features!)
# Get a free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
